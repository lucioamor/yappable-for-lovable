{
  "manifest_version": 3,
  "name": "Yappable for Lovable: voice mode that reads chat & talks back",
  "version": "1.4.0",
  "description": "Voice mode for Lovable: reads every build aloud, hands-free, in your language. Native or ElevenLabs voices.",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://lovable.dev/*"
  ],
  "optional_host_permissions": [
    "https://api.elevenlabs.io/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "lovable_audio_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lovable.dev/*"
      ],
      "js": [
        "src/logger.js",
        "src/tts-provider.js",
        "src/audio-store.js",
        "src/eleven-stream.js",
        "src/stats.js",
        "src/risk-detector.js",
        "src/ir-builder.js",
        "src/renderer.js",
        "src/silence-monitor.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Yappable for Lovable",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/single-sound-message-icq-ooh.mp3"
      ],
      "matches": [
        "https://lovable.dev/*"
      ]
    }
  ]
}
