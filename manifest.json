{
  "manifest_version": 3,
  "name": "Yappable for Lovable: voice mode that reads chat & talks back",
  "version": "1.0.0",
  "description": "Lovable extension that talks back: reads every build aloud — what changed, why it matters, next steps. Hands-free voice updates.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://api.elevenlabs.io/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "lovable_audio_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["src/logger.js", "src/tts-provider.js", "src/risk-detector.js", "src/ir-builder.js", "src/renderer.js", "src/silence-monitor.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://grok.com/*"],
      "js": ["src/media-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://grok.com/*"],
      "js": ["src/chat-adapters.js", "src/player-ui.js", "src/chat-narrator.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Yappable for Lovable",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/single-sound-message-icq-ooh.mp3"],
      "matches": ["https://lovable.dev/*"]
    }
  ]
}
